{
  "name": "food-flow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @food-flow/web dev",
    "build": "pnpm --filter @food-flow/web build",
    "start": "pnpm --filter @food-flow/web start",
    "dev:motion": "pnpm --filter @food-flow/experiment-motion dev",
    "dev:gsap": "pnpm --filter @food-flow/experiment-gsap dev",
    "dev:react-spring": "pnpm --filter @food-flow/experiment-react-spring dev",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @food-flow/web test"
  }
}
